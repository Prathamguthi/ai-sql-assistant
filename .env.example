# Copy to .env and fill in. Leave both keys empty to run in offline "mock" mode.
LLM_PROVIDER=            # anthropic | openai | mock   (auto-detected from keys if empty)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=               # optional override, e.g. claude-sonnet-5-5

DB_PATH=database/app.db
MAX_ROWS=500
QUERY_TIMEOUT_S=5
MAX_SQL_RETRIES=2
AGENT_MAX_STEPS=6

# Optional shared secret. If set, every /api call needs header  X-API-Key: <value>
API_KEY=
CORS_ORIGINS=http://localhost:8501

# Frontend -> backend URL
API_URL=http://localhost:8000
